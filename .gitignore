# ---------------------------------------------------------------------------
# Secrets
#
# epubToWav/csvToWav.py reads DEEPGRAM_API_KEY from a .env file. That .env was
# committed to this public repo -- see README. Never commit it again.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
venv/
.venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
*.egg-info/
.eggs/
dist/
build/
pip-wheel-metadata/
.Python
pyvenv.cfg

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.coverage
htmlcov/

# ---------------------------------------------------------------------------
# Pipeline output
#
# Regenerated by epubToCsv.py and csvToWav.py. The WAVs in particular cost
# Deepgram credits to produce and are derived from whatever EPUB was fed in --
# keep them out of version control.
# ---------------------------------------------------------------------------
epubToWav/csvOutput/
epubToWav/wavOutput/
epubToWav/output.wav
*.wav
!Tranium/AutoAudioNitish/audio/*.wav

# ---------------------------------------------------------------------------
# Training output
# ---------------------------------------------------------------------------
checkpoints/
*.ckpt
*.onnx
*.pt
*.pth
cache/
lightning_logs/

